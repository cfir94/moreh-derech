// האתר הראשי ב-Cloudflare Workers (קבצים סטטיים). פריסה: .github/workflows/deploy-cloudflare.yml.
// הבנייה (npm run build עם NEXT_PUBLIC_BASE_PATH="") יוצרת את ../../out.
{
  "$schema": "../../history-talk/node_modules/wrangler/config-schema.json",
  "name": "moreh-derech",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "../../out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // רק הכתובות הישנות מפעילות קוד. כל השאר מוגש ישירות, בחינם ובלי להיספר במכסה.
    "run_worker_first": ["/moreh-derech", "/moreh-derech/*", "/api/*"]
  },
  // הדומיין נקנה ב-7.11. ‏www מגיש את אותו אתר. תגי ה-canonical מצביעים על moreyderech.com.
  // התשלום הידני (deploy/site/notify.ts). סודות, דרך `wrangler secret put` בלבד:
  //   SUPABASE_SERVICE_KEY, RESEND_API_KEY. בלעדיהם ההודעות מדלגות והאתר עובד כרגיל.
  "vars": {
    "SUPABASE_URL": "https://dendxtbaxiszohjjsdtd.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRlbmR4dGJheGlzem9oampzZHRkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY2OTMzMTcsImV4cCI6MjEwMjI2OTMxN30.rDYzH-3Pz2-XOYoUgrJW7GfTvdrZ7usqbSdtTZ4my6g",
    "OWNER_INBOX": "office@moreyderech.com",
    "MAIL_FROM": "אבן דרך למורי דרך <office@moreyderech.com>",
    "SITE_ORIGIN": "https://moreyderech.com"
  },
  // כל בוקר ב-06:00 UTC (08:00/09:00 בישראל): תזכורות לסוף מנוי וסיכום לבעלים.
  "triggers": { "crons": ["0 6 * * *"] },
  "routes": [
    { "pattern": "moreyderech.com", "custom_domain": true },
    { "pattern": "www.moreyderech.com", "custom_domain": true }
  ]
}
