// "דבר עם ההיסטוריה" — Worker אחד שמגיש גם את הקבצים הסטטיים.
// סודות (לא כאן!): GEMINI_API_KEY, TURNSTILE_SECRET — `wrangler secret put`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "history-talk",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  // ה-Worker רץ ראשון על כל בקשה כדי להוסיף כותרות אבטחה גם לקבצים הסטטיים.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },

  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "275fa6033d7d4dfa8ef7c398626a67fd" }
  ],

  // עד 5 בקשות אסימון בדקה לכל IP (נספר בנפרד בכל מיקום של Cloudflare).
  "ratelimits": [
    { "name": "TOKEN_LIMITER", "namespace_id": "4107", "simple": { "limit": 5, "period": 60 } },
    // צ'אט בכתב: עד 30 בקשות בדקה לכל IP (הודעה + סבבי כלים).
    { "name": "CHAT_LIMITER", "namespace_id": "4108", "simple": { "limit": 30, "period": 60 } }
  ],

  // אין "limits.cpu_ms": התוכנית החינמית דוחה אותו (קוד 100328). להחזיר במעבר לתוכנית בתשלום.

  "observability": { "enabled": true },

  "vars": {
    "GEMINI_LIVE_MODEL": "gemini-3.8-live",
    // הצ'אט בכתב (generateContent). Flash-Lite קודם: בתוכנית החינמית המכסה היומית שלו גבוהה בהרבה
    // מזו של Flash (כ-20 בקשות ביום). Flash נשאר גיבוי. במעבר לתשלום אפשר להחליף ל-"gemini-flash-latest".
    "GEMINI_CHAT_MODEL": "gemini-flash-lite-latest",
    // ראו docs/api-notes.md: התיעוד אומר v1beta, ה-SDK אומר v1alpha.
    "GEMINI_API_VERSION": "v1beta",
    // מקורות שמותר להם לבקש אסימון (בנוסף למקור של ה-Worker עצמו).
    "ALLOWED_ORIGINS": "https://cfir94.github.io,https://moreyderech.com,https://www.moreyderech.com,https://moreh-derech.cfir94.workers.dev,http://localhost:3000,http://localhost:5173",
    // מי רשאי להטמיע את העמוד ב-iframe.
    "FRAME_ANCESTORS": "https://cfir94.github.io https://moreyderech.com https://www.moreyderech.com https://moreh-derech.cfir94.workers.dev http://localhost:3000",
    "FREE_TIER_MODE": "true",
    // "1" = שיחה רק למנויים ולשבוע הניסיון (בדיקה מול md_has_access). כבוי עד שהתשלומים פעילים.
    "REQUIRE_ENTITLEMENT": "0",
    // הפרויקט של האתר. מפתח anon ציבורי, זהה לזה שב-src/lib/cloudAuth.ts.
    "SUPABASE_URL": "https://dendxtbaxiszohjjsdtd.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRlbmR4dGJheGlzem9oampzZHRkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY2OTMzMTcsImV4cCI6MjEwMjI2OTMxN30.rDYzH-3Pz2-XOYoUgrJW7GfTvdrZ7usqbSdtTZ4my6g",
    "MAX_SESSION_MINUTES": "12",
    // מכסות יומיות; "0" = בלי הגבלה (המגבלה בפועל: 65 אלף טוקנים לדקה אצל Gemini).
    "DAILY_SESSIONS_PER_IP": "0",
    "DAILY_SESSIONS_GLOBAL": "0",
    // Site key ציבורי של widget "history-talk" (דומיין: history-talk.cfir94.workers.dev).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFiadBD73TrLR-8G"
  }
}
